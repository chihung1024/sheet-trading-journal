{
  "name": "saas-trading-journal-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "environment:check": "node tools/check_frontend_environment.mjs",
    "prebuild": "npm run environment:check",
    "build": "vite build",
    "worker:config:check": "node tools/check_worker_config.mjs",
    "worker:config:render": "node tools/render_wrangler_config.mjs",
    "worker:deploy": "wrangler deploy --strict --config .wrangler/deploy.toml"
  },
  "dependencies": {
    "vue": "3.4.21",
    "pinia": "2.1.7",
    "chart.js": "4.4.1",
    "date-fns": "3.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.0.4",
    "vite": "5.1.4",
    "wrangler": "4.114.0"
  }
}
